# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올라가지 않는다.

# data.go.kr 마이페이지의 "일반 인증키(Decoding)" 값
DATA_GO_KR_SERVICE_KEY=

# 수집 대상 시도 코드 (11 = 서울. 활용가이드의 코드표 참고)
COLLECT_ZCODE=11

# 카카오맵 JavaScript 키 (검색 화면의 지도). 카카오 개발자 콘솔에서 Web 도메인 http://localhost:8280 등록, 카카오맵 사용 설정 필요.
# 비워 두면 화면은 지도 없이 목록으로 동작한다
KAKAO_MAP_JS_KEY=

# 개발·시연용 상태 변경 주입기(/dev/**). 인증 없는 쓰기 기능이라 기본은 false.
# 로컬에서 시연할 때만 true로 바꾼다 (운영에서는 반드시 false)
DEV_TOOLS_ENABLED=false
